{
  "name": "@pos/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Restaurant POS REST API \u2014 Rust on Cloudflare Workers, D1 + Upstash.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "cargo check --target wasm32-unknown-unknown && npm test",
    "db:migrate:local": "wrangler d1 migrations apply restaurant-pos --local",
    "db:migrate:remote": "wrangler d1 migrations apply restaurant-pos --remote",
    "db:seed:local": "wrangler d1 execute restaurant-pos --local --file=./seed.sql",
    "test": "cargo test -p pos-core && cargo test -p pos-api",
    "claim:bootstrap": "node scripts/bootstrap-link.mjs",
    "pin:set": "node scripts/set-pin.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
